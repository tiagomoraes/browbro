# The App Store Connect half of a BrowBro release.
#
# The build half is .github/workflows/app-store.yml: it archives BrowBroMAS,
# verifies it, and uploads it with xcodebuild. What is left after that is
# everything Connect asks a human for — which build number is free, when the
# upload is usable, what the product page says, and, when asked to submit,
# which build the version ships and the act of submitting. These lanes do that
# part.
#
# Nothing here builds or signs anything.

require "yaml"

default_platform(:mac)

APP_ID = "cloud.tiagomoraes.browbro".freeze

# Every lane authenticates the same way: the App Store Connect API key that the
# workflow puts in the environment. No Apple ID, no session cookie, no 2FA —
# those cannot survive in CI.
def asc_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_CONTENT"),
    in_house: false
  )
end

# One of BrowBroMAS's own build settings in project.yml. Read from the file
# rather than passed in, so the workflow cannot ship a build against a version
# the repository does not agree with.
def mas_setting(key)
  yml = YAML.safe_load_file(File.expand_path("../project.yml", __dir__))
  settings = yml.dig("targets", "BrowBroMAS", "settings", "base") or
    UI.user_error!("No BrowBroMAS target settings in project.yml")
  value = settings[key] or UI.user_error!("BrowBroMAS has no #{key} in project.yml")
  value.to_s
end

# MARKETING_VERSION, which is what Connect calls the version string.
def marketing_version
  mas_setting("MARKETING_VERSION")
end

# Build numbers are compared as numbers, never as the strings Connect returns.
# BrowBro's are plain integers; anything else is a mistake worth stopping on.
def build_integer(value, what)
  Integer(value.to_s, 10)
rescue ArgumentError
  UI.user_error!("#{what} is #{value.inspect}, not a whole-number build")
end

platform :mac do
  desc "Print the build number to archive: one past the highest of Connect's latest upload"
  desc "for this MARKETING_VERSION, its latest upload for any version, and BrowBroMAS's"
  desc "CURRENT_PROJECT_VERSION in project.yml. Writes it to $GITHUB_OUTPUT in Actions."
  lane :next_build_number do
    version = marketing_version

    # Connect refuses a build number it has already accepted, and it remembers
    # ones that were uploaded and never shipped — 8 and 9 of 1.0 both count,
    # though only 9 went to review. A Mac build number also has to keep rising
    # from one version to the next, so 1.1 carries on from 1.0's numbers rather
    # than starting again at 1. Asking is the only way to be right; a counter in
    # the repo drifts the moment anyone uploads by hand.
    #
    # latest_testflight_build_number answers with the most recent upload (Connect
    # sorts by upload date), not the highest number, so no single answer is
    # trusted: take the largest of this version's, any version's, and the floor
    # project.yml records for the last build that shipped.
    latest = lambda do |for_version|
      found = latest_testflight_build_number(
        api_key: asc_key,
        app_identifier: APP_ID,
        platform: "osx",
        version: for_version,
        initial_build_number: 0
      )
      build_integer(found, "Connect's latest build for #{for_version || 'any version'}")
    end
    this_version = latest.call(version)
    any_version = latest.call(nil)
    floor = build_integer(mas_setting("CURRENT_PROJECT_VERSION"), "BrowBroMAS's CURRENT_PROJECT_VERSION")

    build = [this_version, any_version, floor].max + 1
    UI.success("#{version}: latest upload for #{version} is #{this_version}, latest for any version is " \
               "#{any_version}, project.yml floor is #{floor} → archiving #{build}")

    if ENV["GITHUB_OUTPUT"]
      File.open(ENV["GITHUB_OUTPUT"], "a") do |f|
        f.puts("build_number=#{build}")
        f.puts("marketing_version=#{version}")
      end
    end
    build
  end

  desc "Block until Connect has processed the build and found it VALID, the only state in"
  desc "which a version can ship it. Fails on INVALID or FAILED, or after 45 minutes."
  lane :wait_for_build do |options|
    version = marketing_version
    UI.user_error!("wait_for_build needs build_number:") if options[:build_number].to_s.empty?
    want = build_integer(options[:build_number], "build_number:").to_s

    # Connect takes minutes to process a macOS upload — 1.0 (9) took about five on
    # 2026-09-13 — and a submission can only ship a build that came out VALID.
    # Seeing the build listed proves nothing: the upload is listed from the
    # moment it arrives, still PROCESSING, and stays listed if it fails. So this
    # watches the build's own processing state. BuildWatcher returns once the
    # build leaves PROCESSING, which includes INVALID and FAILED; the state is
    # checked after.
    #
    # BuildWatcher is plain Spaceship. The actions above authenticate themselves
    # from api_key:, but this uses whatever token Spaceship holds, so set it.
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: asc_key)
    app = Spaceship::ConnectAPI::App.find(APP_ID) or
      UI.user_error!("No app with bundle id #{APP_ID} in App Store Connect")

    timeout = 45 * 60
    deadline = Time.now + timeout
    begin
      build = FastlaneCore::BuildWatcher.wait_for_build_processing_to_be_complete(
        app_id: app.id,
        platform: "osx",
        app_version: version,
        build_version: want,
        poll_interval: 30,
        timeout_duration: timeout,
        return_spaceship_testflight_build: false
      )
    rescue FastlaneCore::Interface::FastlaneCrash
      # BuildWatcher reports its timeout as a crash. Any other crash isn't ours.
      raise if Time.now < deadline
      UI.user_error!("#{version} (#{want}) was not VALID after #{timeout / 60} minutes: still processing, or " \
                     "never listed — the lines above say which. Check the build in App Store Connect.")
    end

    state = build.processing_state
    unless state == Spaceship::ConnectAPI::Build::ProcessingState::VALID
      UI.user_error!("Connect finished processing #{version} (#{want}) as #{state}, so no version can ship it. " \
                     "The build's page in App Store Connect says why; fix that and upload again.")
    end
    UI.success("#{version} (#{want}) is processed and VALID.")
  end

  desc "Push the product page for MARKETING_VERSION. With submit:true, also choose build_number:"
  desc "as the build that version ships and submit it for review; without, no build is chosen."
  desc "Options: build_number: (required), submit: true|false, screenshots: true|false"
  lane :publish do |options|
    version = marketing_version
    build = options[:build_number].to_s
    UI.user_error!("publish needs build_number:") if build.empty?

    submit = options[:submit].to_s == "true"
    screenshots = options[:screenshots].to_s == "true"

    # listing.md is the source of truth; this regenerates the tree deliver reads
    # and fails loudly if a section went missing. Running it here means a lane
    # invoked by hand behaves exactly like the workflow.
    sh("python3", "../packaging/mas/listing-to-metadata.py")

    if screenshots
      # Staged, not committed: packaging/mas/screenshots is where they are
      # authored and rendered, and deliver wants one directory per locale.
      dest = File.expand_path("screenshots/en-US", __dir__)
      FileUtils.rm_rf(dest)
      FileUtils.mkdir_p(dest)
      src = Dir[File.expand_path("../packaging/mas/screenshots/*.png", __dir__)].sort
      UI.user_error!("No screenshots in packaging/mas/screenshots") if src.empty?
      FileUtils.cp(src, dest)
      UI.message("Staged #{src.length} screenshots for upload")
    end

    deliver(
      api_key: asc_key,
      app_identifier: APP_ID,
      platform: "osx",
      app_version: version,
      # Read only when submitting: choosing the build for the version is part of
      # deliver's submission, and nothing else touches it. Run wait_for_build
      # first — deliver picks this number as it stands, processed or not.
      build_number: build,

      # The binary is already in Connect — the workflow put it there with
      # xcodebuild. deliver's job is the version record, not the upload.
      skip_binary_upload: true,
      skip_metadata: false,
      skip_app_version_update: false,

      # Screenshots are opt-in. They change once a year at most, re-uploading
      # them on every release is a slow way to risk the listing, and
      # overwrite_screenshots deletes what is live before it replaces it.
      skip_screenshots: !screenshots,
      overwrite_screenshots: screenshots,

      metadata_path: File.expand_path("metadata", __dir__),
      screenshots_path: File.expand_path("screenshots", __dir__),

      # No HTML preview and no "are you sure" — there is no one at the terminal.
      force: true,
      run_precheck_before_submit: false,

      submit_for_review: submit,
      automatic_release: true,

      # Answers Connect would otherwise block the submission waiting for.
      # ITSAppUsesNonExemptEncryption is already false in Resources/Info-MAS.plist;
      # this is the same answer on the version record.
      submission_information: {
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false,
        add_id_info_uses_idfa: false
      }
    )

    if submit
      UI.success("#{version} ships build #{build} and is submitted for review.")
    else
      UI.success("#{version}: product page updated. No build is chosen for it yet — pick #{build} on the " \
                 "version page in App Store Connect and submit from there when ready.")
    end
  end
end
