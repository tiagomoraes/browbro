<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Mac App Store requires App Sandbox (guideline 2.4.5(i)). -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <!-- User-selected files only:
       - Chrome profiles: the user picks ~/Library/Application Support/Google/Chrome
         in an open panel; we only read it, and persist the grant as an app-scoped
         bookmark.
       - Launch helper: the user saves BrowBro's launch script into
         ~/Library/Application Scripts/<bundle id> through a save panel — the one
         write, and the reason this is read-write (Sources/LaunchHelper.swift). -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <key>com.apple.security.files.bookmarks.app-scope</key>
  <true/>
</dict>
</plist>
